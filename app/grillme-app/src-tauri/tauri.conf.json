{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrillMe",
  "version": "0.1.0",
  "identifier": "com.aryanmotgi.grillme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GrillMe",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Live dashboard for vibe-coding sessions",
    "longDescription": "GrillMe watches your project's .grillme/state.json, PLAN.md, LEARNED.md, and GRILLME.md and renders a live dashboard with a hackathon timer, plan progress, learnings log, and Codex run status.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
